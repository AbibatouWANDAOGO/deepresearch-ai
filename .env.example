# Copy this file to .env and adjust. Never commit .env: it may contain API keys.

# --- Language model -------------------------------------------------------------
# ollama (free, local) | anthropic (paid) | openai (paid)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=120

# --- Cost guardrails ------------------------------------------------------------
# Paid LLM providers are refused unless this is true.
ALLOW_PAID_APIS=false
MAX_COST_USD_PER_RESEARCH=0.50

# --- Web search -----------------------------------------------------------------
# tavily (free tier, API key) | duckduckgo (no key)
SEARCH_PROVIDER=tavily
# Used when the main provider fails (quota, outage, missing key): duckduckgo | none
SEARCH_FALLBACK=duckduckgo
TAVILY_API_KEY=
# Searches are refused locally beyond this many credits per calendar month (free tier: 1000).
TAVILY_MONTHLY_CREDIT_LIMIT=1000
MAX_RESULTS_PER_QUERY=5
SEARCH_MAX_RETRIES=2

# --- Research limits ------------------------------------------------------------
MAX_EXTRA_RESEARCH_CYCLES=3
MAX_SOURCES_PER_RESEARCH=20
MAX_RESEARCH_MINUTES=30

# --- Downloads ------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
MAX_DOWNLOAD_MB=10
MAX_REDIRECTS=5
RESPECT_ROBOTS_TXT=true
USER_AGENT=DeepResearchAI/0.1 (research assistant; educational project)

# --- Document processing --------------------------------------------------------
MAX_PDF_PAGES=60
MIN_DOCUMENT_CHARS=300
MAX_DOCUMENT_CHARS=200000

# --- RAG ------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6

# --- Storage --------------------------------------------------------------------
# STORAGE_DIR=storage
LOG_LEVEL=INFO
