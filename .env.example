# Copy this file to .env and adjust. Never commit .env: it may contain API keys.

# --- Language model -------------------------------------------------------------
# ollama (free, local) | anthropic (paid) | openai (paid)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=4096
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1
# Used to estimate and cap spending (USD per million tokens for claude-opus-5-5).
ANTHROPIC_INPUT_USD_PER_MTOK=4.0
ANTHROPIC_OUTPUT_USD_PER_MTOK=20.0

# --- Cost guardrails ------------------------------------------------------------
# Paid LLM providers are refused unless this is true.
ALLOW_PAID_APIS=false
MAX_COST_USD_PER_RESEARCH=0.50

# --- Web search -----------------------------------------------------------------
# tavily (free tier, API key) | duckduckgo (no key)
SEARCH_PROVIDER=tavily
# Used when the main provider fails (quota, outage, missing key): duckduckgo | none
SEARCH_FALLBACK=duckduckgo
TAVILY_API_KEY=
# Searches are refused locally beyond this many credits per calendar month (free tier: 1000).
TAVILY_MONTHLY_CREDIT_LIMIT=1000
MAX_RESULTS_PER_QUERY=5
SEARCH_MAX_RETRIES=2

# --- Research limits ------------------------------------------------------------
MAX_EXTRA_RESEARCH_CYCLES=3
MAX_SOURCES_PER_RESEARCH=20
MAX_RESEARCH_MINUTES=30
# Each LLM call takes about a minute on a laptop CPU: these bound the length of a research.
MAX_SUB_QUESTIONS=3
MAX_CLAIMS_PER_SUB_QUESTION=3
PASSAGES_PER_ANALYSIS=5
# A sub-question is considered answered when this share of its checked claims is supported.
MIN_SUPPORTED_RATIO=0.5

# --- Downloads ------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
MAX_DOWNLOAD_MB=10
MAX_REDIRECTS=5
RESPECT_ROBOTS_TXT=true
USER_AGENT=DeepResearchAI/0.1 (research assistant; educational project)

# --- Document processing --------------------------------------------------------
MAX_PDF_PAGES=60
MIN_DOCUMENT_CHARS=300
MAX_DOCUMENT_CHARS=200000

# --- RAG ------------------------------------------------------------------------
# multilingual-e5-base reads at most 512 tokens: keep chunks below that (the app checks it).
CHUNK_SIZE_TOKENS=480
CHUNK_OVERLAP_TOKENS=72
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_ENABLED=true
# Candidates kept from each retriever, then passages kept after reranking.
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6
# Reciprocal Rank Fusion constant (60 is the value from the original paper).
RRF_K=60
QDRANT_COLLECTION=chunks

# --- Storage --------------------------------------------------------------------
# STORAGE_DIR=storage
LOG_LEVEL=INFO
